global:
  scrape_interval: 15s

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: "proxmox-host"
    static_configs:
      - targets: ["{{ proxmox_node_ip }}:9100"]

  - job_name: "raspberry-pi"
    static_configs:
      - targets: ["{{ pi_ip }}:9100"]
